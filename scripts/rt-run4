#!/usr/bin/env bash
# rt-run4 -- the GR4 twin of the GR3 project's scripts/rt-run.
#
#   ./scripts/rt-run4 MIN MAX RATE CHAINS [--packets N] [--mcs NAME] [--seed S]
#                                         [--chunk N] [--deadline-ms F] [--run]
#
# Same levers, same sample file: the cell is generated by the GR3 project's
# rt-gen (or reused from data/phase10/ there -- both runtimes must replay the
# identical bytes), the GR4 receiver replays it, and the outputs land in
# <cell>/runs4/rate<R>_chains<N>/ beside GR3's runs/ so the two are compared
# packet for packet.  Prints the commands (start htop first); --run executes.
set -u
HERE="$(cd "$(dirname "$0")/.." && pwd)"
GR3="${GR3:-$HOME/gr3-ieee802-11-project}"
cd "$HERE" || exit 1

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
die() { echo "rt-run4: $*" >&2; exit 2; }

[ $# -ge 4 ] || usage
MIN=$1; MAX=$2; RATE=$3; CHAINS=$4; shift 4
PACKETS=1000; MCS=QPSK_1_2; SEED=1; CHUNK=4096; DEADLINE=100; RUN=0
while [ $# -gt 0 ]; do
    case "$1" in
        --packets)     PACKETS=$2; shift 2;;
        --mcs)         MCS=$2; shift 2;;
        --seed)        SEED=$2; shift 2;;
        --chunk)       CHUNK=$2; shift 2;;
        --deadline-ms) DEADLINE=$2; shift 2;;
        --run)         RUN=1; shift;;
        -h|--help)     usage;;
        *) die "unknown option $1";;
    esac
done
int() { case "$1" in ''|*[!0-9]*) return 1;; esac; }
int "$MIN" && int "$MAX" || die "MIN and MAX must be integers"
[ "$MIN" -ge 8 ] && [ "$MAX" -le 1500 ] && [ "$MIN" -le "$MAX" ] || die "need 8 <= MIN <= MAX <= 1500"
int "$CHAINS" && [ "$CHAINS" -ge 1 ] || die "CHAINS must be >= 1"
RATE_HZ=$(python3 -c "import sys
try:
    r=float(sys.argv[1]); print('bad' if r<0 else ('%d' % r if r==int(r) else '%g' % r))
except ValueError: print('bad')" "$RATE")
[ "$RATE_HZ" != bad ] || die "RATE must be a number of samples/s (0 = unthrottled)"
[ -x build/rx_latency4 ] || die "build/rx_latency4 missing -- cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j1"

CELL="$GR3/data/phase10/rt_${MIN}_${MAX}_${PACKETS}_${MCS}_s${SEED}"
if [ -s "$CELL/rx_stimulus.cf32" ] && [ -s "$CELL/manifest.json" ]; then
    echo "rt-run4: reusing $CELL (the same bytes GR3 replays)"
else
    echo "rt-run4: generating the cell with the GR3 project's rt-gen"
    ( cd "$GR3" && ./scripts/rt-gen "$MIN" "$MAX" "$PACKETS" --out "$CELL" --mcs "$MCS" --seed "$SEED" ) 2>&1 | grep -E "^rt-gen:|^gen-input: [0-9]|^tx_capture: emitted" || die "generation failed"
    [ -s "$CELL/rx_stimulus.cf32" ] || die "no $CELL/rx_stimulus.cf32"
fi
TAG="rate${RATE_HZ}_chains${CHAINS}"; [ "$CHUNK" = 4096 ] || TAG="${TAG}_chunk${CHUNK}"
OUT="$CELL/runs4/$TAG"
mkdir -p "$OUT" || die "cannot create $OUT"
CMD="./build/rx_latency4 --run-dir $CELL --input $CELL/rx_stimulus.cf32 --out-dir $OUT --rate $RATE_HZ --chains $CHAINS --chunk $CHUNK --deadline-ms $DEADLINE"
SUM="python3 -c \"import json; s=json.load(open('$OUT/latency_summary.json')); [print('chain %d: %d/%d decoded (%s wrong payload), last->decode us p50 %.0f p95 %.0f p99 %.0f max %.0f, %d over %g ms' % (c['chain'], c['decoded'], c['frames'], c['wrong_payload'], c['p50_us'], c['p95_us'], c['p99_us'], c['max_us'], c['deadline_misses'], s['latency']['deadline_ms'])) for c in s['per_chain']]\""
GR3OUT="$CELL/runs/$TAG"
cat <<EOF

rt-run4: $CHAINS GR4 receiver(s) at $( [ "$RATE_HZ" = 0 ] && echo unthrottled || echo "$RATE_HZ samples/s" ), chunk $CHUNK, deadline $DEADLINE ms
rt-run4: outputs -> $OUT/{latency.csv,latency_summary.json}
rt-run4: the GR3 run of the same configuration is $GR3OUT (./scripts/rt-run in the GR3 project)

# 1. in another terminal:
htop -t

# 2. the GR4 receiver(s):
$CMD

# 3. the numbers:
$SUM

# 4. GR3 vs GR4 on this cell, packet for packet (both must have run):
python3 $HERE/scripts/compare-runs.py $GR3OUT/latency.csv $OUT/latency.csv
EOF
if [ "$RUN" -eq 1 ]; then
    echo; echo "rt-run4: --run given, executing step 2 now"
    $CMD; rc=$?
    echo; eval "$SUM" 2>/dev/null
    exit $rc
fi
