#!/usr/bin/env python3
"""rt-microbench4 -- the microbenchmarks that check the mechanisms behind the sweep's results.

    ./scripts/rt-microbench4 --out-dir DIR [--cell CELL] [--only M1,M2,...] [--cpus LIST]

  M1  isolated per-block cost: the receiver unthrottled on one worker with a batch ceiling N,
      workExact tracing only -> mean/max ns per call and ns per input sample per block; the sum
      over the batch path is the floor of the batch response time
  M2  scheduler cost per invocation: microbench4 (synthetic Copy chains) under RR, EDF, RM at
      N = 1024 and 4096, 1 and 3 chains, with and without explicit deadlines and with every trace
      category live; ns per invocation, best of 3
  M3  the non-preemptive blocking bound: the longest single invocation of any block at each N
      (from M1), the most a tight job can wait behind a running job
  M4  EDF selection oracle: one 30 s run at a contention point with the class deadlines
      (2 workers, 3 receivers, 2.5 Msps, N = 1024, chain 0 at 0.25) and one at equal deadlines,
      tables kept -> trace-edf-oracle.py: fraction of job starts that passed over a ready job
      with an earlier deadline
  M6  scheduler pass cost on four workers: the light multi-rate mix (1.25, 1.25, 2.5, 5 Msps,
      rotation 1, 20 s) under RR, EDF and RM at process_stream_to_message_ratio 16 (the default)
      and 4096, with every event category traced -> per worker, the rate, mean and p99 duration
      and the busy share of every scheduler event kind (sweep, stateSync, messagePhase,
      releaseScan, ...) inside the analysis window, next to the batch RT of every receiver.
      The selection pass carries an explicit wall-clock budget (M6_PASS_US): the count bound is
      left at its default, but the budget's own auto rule reads the declared period, which this
      workload sets to 1 us to disarm the release gate -- see M6_PASS_US below
  M5  trace overhead at an unsaturated point: 1 receiver, 1 worker, 2.5 Msps, N = 1024, 30 s,
      every policy, every category live against no category -> frame response time
Writes DIR/micro.json and DIR/MICRO.md (tables).  Takes about ten minutes; run it with the
machine otherwise idle.  --cpus LIST pins every rx_latency4 run's workers to the first N CPUs of
LIST (rx_latency4 --cpus; N = that run's --threads); on a guest with isolated CPUs this is the
only way the workers get them (docs/e2e-sweep-runbook.md 13).  The list is recorded per run as
worker_cpus in latency_summary.json and in the M6 section of micro.json.
"""
import argparse, json, os, subprocess, sys, glob
import numpy as np
import pandas as pd

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RX = os.path.join(HERE, "build", "rx_latency4"); MB = os.path.join(HERE, "build", "microbench4"); EXP = os.path.join(HERE, "build", "trace_export")
ANALYSE = os.path.join(HERE, "scripts", "trace-batch-rt.py"); ORACLE = os.path.join(HERE, "scripts", "trace-edf-oracle.py")
PRE = ["throttle", "mag2", "avgpow", "dly16", "conj", "mul", "avgcor", "mag", "div", "syncshort"]
POST = ["dly320", "synclong", "fft", "eq", "decode"]


def sh(cmd, log=None):
    print("+ " + " ".join(cmd), flush=True)
    r = subprocess.run(cmd, capture_output=True, text=True)
    if log:
        open(log, "a").write(" ".join(cmd) + "\n" + r.stdout + r.stderr + "\n")
    if r.returncode != 0:
        print(r.stderr[-800:], file=sys.stderr)
    return r


def m1(cell, out, log):
    res = {}
    for N in (1024, 2048, 4096):
        d = os.path.join(out, f"m1_N{N}")
        os.makedirs(d, exist_ok=True)
        sh([RX, "--run-dir", cell, "--out-dir", d, "--rate", "0", "--chains", "1", "--threads", "1", "--policy", "rr", "--batch", str(N), "--buffer", str(16 * N),
            "--max-samples", "20000000", "--timeout-s", "120", "--trace-categories", "0x104", "--trace-buffer", "8388608", "--trace-out", os.path.join(d, "trace.gr4trace")], log)
        sh([EXP, os.path.join(d, "trace.gr4trace"), "--out-dir", d, "--meta", os.path.join(d, "trace_meta.json")], log)
        I = pd.read_csv(os.path.join(d, "trace_invocations.csv"), dtype={"role": str})
        I = I[(I["in"] > 0) | (I["out"] > 0)]
        per = {}
        for role, g in I.groupby("role"):
            samples = int(g["out"].sum()) if role == "fsrc" else int(g["in"].sum())
            per[role] = {"calls": int(len(g)), "mean_us": float(g.dur_ns.mean() / 1e3), "p99_us": float(g.dur_ns.quantile(0.99) / 1e3), "max_us": float(g.dur_ns.max() / 1e3),
                         "ns_per_sample": float(g.dur_ns.sum() / samples) if samples else None, "mean_in": float(g["in"].mean())}
        floor = sum(per[r]["mean_us"] for r in PRE if r in per)
        res[N] = {"per_block": per, "floor_us_excl_throttle": floor, "longest_call_us": max(v["max_us"] for v in per.values()), "longest_call_block": max(per, key=lambda r: per[r]["max_us"])}
        for f in ("trace.gr4trace", "trace_invocations.csv", "trace_work.csv", "trace_probes.csv"):
            fp = os.path.join(d, f)
            if os.path.exists(fp):
                os.remove(fp)
    return res


def m2(out, log):
    res = []
    for N in (1024, 4096):
        for C in (1, 3):
            for pol in ("rr", "edf", "rm"):
                for variant in ("plain", "deadlines", "traced"):
                    cmd = [MB, "--policy", pol, "--chains", str(C), "--length", "9", "--batch", str(N), "--samples", "20000000", "--threads", "1"]
                    if variant == "deadlines":
                        cmd += ["--deadlines", ",".join(["0.0001"] + ["0.0004"] * (C - 1))]
                    if variant == "traced":
                        cmd += ["--trace", "0x1ff", "--deadlines", ",".join(["0.0001"] + ["0.0004"] * (C - 1))]
                    best = None
                    for _ in range(3):
                        r = sh(cmd, log)
                        if r.returncode == 0:
                            j = json.loads(r.stdout.strip().splitlines()[-1])
                            if best is None or j["ns_per_invocation"] < best["ns_per_invocation"]:
                                best = j
                    if best:
                        best["variant"] = variant
                        res.append(best)
    return res


def m4(cell, out, log):
    res = {}
    for name, extra in (("A25", ["--deadline-classes", "0.25,1,1"]), ("base", [])):
        d = os.path.join(out, f"m4_{name}")
        os.makedirs(d, exist_ok=True)
        sh([RX, "--run-dir", cell, "--out-dir", d, "--rate", "2500000", "--chains", "3", "--threads", "2", "--policy", "edf", "--fixed-batch", "1024", "--max-samples", str(30 * 2500000),
            "--timeout-s", "120", "--trace-categories", "all", "--trace-buffer", "16777216", "--trace-limit-mb", "1024", "--trace-out", os.path.join(d, "trace.gr4trace")] + extra, log)
        sh([sys.executable, ANALYSE, d, "--warmup", "5", "--window", "20", "--quiet"], log)
        r = sh([sys.executable, ORACLE, d, "--warmup", "5", "--window", "20"], log)
        b = json.load(open(os.path.join(d, "batch_rt.json")))
        o = json.load(open(os.path.join(d, "edf_oracle.json")))
        res[name] = {"oracle": o, "per_chain_batch_rt": [pc.get("batch_rt") for pc in b["per_chain"]], "saturated": b.get("saturated"), "edf": b.get("edf", {}).get("per_chain")}
        for f in glob.glob(os.path.join(d, "trace_*.csv")) + [os.path.join(d, "trace.gr4trace")]:
            if os.path.exists(f) and not f.endswith(("trace_header.json", "trace_kinds.csv", "trace_entities.csv")):
                os.remove(f)
    return res


def m5(cell, out, log):
    res = {}
    for pol in ("rr", "edf", "rm"):
        for traced in (True, False):
            d = os.path.join(out, f"m5_{pol}_{'trace' if traced else 'notrace'}")
            os.makedirs(d, exist_ok=True)
            cmd = [RX, "--run-dir", cell, "--out-dir", d, "--rate", "2500000", "--chains", "1", "--threads", "1", "--policy", pol, "--fixed-batch", "1024", "--max-samples", str(30 * 2500000), "--timeout-s", "120"]
            if traced:
                cmd += ["--trace-categories", "all", "--trace-buffer", "16777216", "--trace-limit-mb", "1024", "--trace-out", os.path.join(d, "trace.gr4trace")]
            sh(cmd, log)
            sh([sys.executable, ANALYSE, d, "--warmup", "5", "--window", "20", "--quiet"], log)
            b = json.load(open(os.path.join(d, "batch_rt.json")))
            pc = b["per_chain"][0]
            res[f"{pol}_{'traced' if traced else 'untraced'}"] = {"frame_rt": pc["frame_rt"], "batch_rt": pc.get("batch_rt"), "elapsed_s": b.get("elapsed_s"), "realtime_ratio": b.get("realtime_ratio")}
            for f in glob.glob(os.path.join(d, "trace_*.csv")) + [os.path.join(d, "trace.gr4trace")]:
                if os.path.exists(f) and not f.endswith(("trace_header.json", "trace_kinds.csv", "trace_entities.csv")):
                    os.remove(f)
    return res


M6_KINDS = ("sweep", "stateSync", "messagePhase", "houseKeeping", "releaseScan", "select", "selectEmpty", "workProbe", "zombieReap", "adopt", "schedulerMessages", "removalCleanup", "blockMessages", "selectionBoundHit")
K_BOUND_WAS_TIME = 1 << 2  # gr::trace::flag::kBoundWasTime: the pass budget, not the selection count, ended the pass
M6_RATES = "1250000,1250000,2500000,5000000"
M6_BATCH = 1024
# A quarter of the fastest receiver's batch period, which is what the scheduler's own auto rule
# would pick if it could see that period. It cannot: every block here declares a 1 us `period` so
# that EDF's release gate never paces the pipeline (src/chain.cpp), and the deadlines carry the real
# timing instead -- so the auto budget would come out at 250 ns and end every pass after a single
# selection. Stated rather than derived, because the deadline is what this workload means by period.
M6_PASS_US = round(0.25 * M6_BATCH / max(float(r) for r in M6_RATES.split(",")) * 1e6)


CPUS = []  # --cpus LIST, appended to every rx_latency4 command


def pin():
    return ["--cpus", ",".join(map(str, CPUS))] if CPUS else []


def m6(cell, out, log):
    res = {}
    for ratio in (16, 4096):
        for pol in ("rr", "edf", "rm"):
            d = os.path.join(out, f"m6_{pol}_r{ratio}")
            os.makedirs(d, exist_ok=True)
            cmd = [RX, "--run-dir", cell, "--out-dir", d, "--chains", "4", "--threads", "4", "--policy", pol, "--fixed-batch", str(M6_BATCH), "--rates", M6_RATES, "--run-s", "20", "--rotate", "1",
                   "--sched-ratio", str(ratio), "--max-pass-duration", str(M6_PASS_US), "--timeout-s", "200", "--trace-categories", "all", "--trace-buffer", "16777216", "--trace-limit-mb", "1024", "--trace-out", os.path.join(d, "trace.gr4trace")] + pin()
            sh(cmd, log)
            sh([EXP, os.path.join(d, "trace.gr4trace"), "--out-dir", d, "--meta", os.path.join(d, "trace_meta.json"), "--all-events"], log)
            sh([sys.executable, ANALYSE, d, "--warmup", "3", "--window", "12", "--quiet"], log)
            b = json.load(open(os.path.join(d, "batch_rt.json")))
            ls = json.load(open(os.path.join(d, "latency_summary.json")))
            w0, w1 = b["window_ns"]; span = (w1 - w0) / 1e9
            E = pd.read_csv(os.path.join(d, "trace_events.csv")); E = E[(E.start_ns >= w0) & (E.start_ns < w1)]
            workers = sorted(E.worker.unique()); T = max(len(workers), 1)
            kinds = {}
            for k in M6_KINDS:
                x = E[E.kind == k]
                if len(x):
                    kinds[k] = {"per_s_per_worker": len(x) / span / T, "mean_us": float(x.dur_ns.mean() / 1e3), "p99_us": float(x.dur_ns.quantile(0.99) / 1e3), "max_us": float(x.dur_ns.max() / 1e3), "busy_share": float(x.dur_ns.sum() / 1e9 / span / T)}
            ss = E[E.kind == "stateSync"]
            discarded = {"mean": float(ss.p1.mean()), "max": int(ss.p1.max()), "syncs_with_discards": float((ss.p1 > 0).mean())} if len(ss) else None
            bh = E[E.kind == "selectionBoundHit"]
            by_time = (bh["flags"] & K_BOUND_WAS_TIME) != 0
            bound_hits = {"time_per_s_per_worker": int(by_time.sum()) / span / T, "count_per_s_per_worker": int((~by_time).sum()) / span / T}
            sw = E[E.kind == "sweep"].sort_values(["worker", "start_ns"]); gaps = []
            for _, g in sw.groupby("worker"):
                st = g.start_ns.to_numpy(); en = st + g.dur_ns.to_numpy()
                if len(st) > 1:
                    gaps.append(float(np.mean(st[1:] - en[:-1]) / 1e3))
            res[f"{pol}_r{ratio}"] = {"policy": pol, "sched_ratio": ratio, "max_pass_duration_us": M6_PASS_US, "worker_cpus": ls.get("worker_cpus", []), "window_s": span, "kinds": kinds, "gap_between_sweeps_us": gaps, "jobs_discarded_per_sync": discarded, "bound_hits": bound_hits,
                                      "per_chain": [{"chain": pc["chain"], "rate": pc.get("rate"), "period_us": pc.get("batch_period_us"), "batch_rt": pc.get("batch_rt"), "frame_rt": pc.get("frame_rt"), "saturated": pc.get("saturated"), "edf": pc.get("edf")} for pc in b["per_chain"]],
                                      "occupancy": b.get("utilization", {}).get("per_worker_occupancy")}
            for f in glob.glob(os.path.join(d, "trace_*.csv")) + [os.path.join(d, "trace.gr4trace")]:
                if os.path.exists(f) and not f.endswith(("trace_header.json", "trace_kinds.csv", "trace_entities.csv")):
                    os.remove(f)
    return res


def write_md(res, out):
    L = ["# Microbenchmarks\n", "Generated by `scripts/rt-microbench4`; raw values in `micro.json`.\n"]
    if "M1" in res:
        L.append("\n## M1 — isolated per-block cost (unthrottled, one worker, RR, batch ceiling N)\n")
        for N, r in sorted(res["M1"].items(), key=lambda kv: int(kv[0])):
            L.append(f"\nN = {N}: batch-path floor (sum of mean costs, throttle excluded) {r['floor_us_excl_throttle']:.1f} µs; longest single call {r['longest_call_us']:.0f} µs ({r['longest_call_block']})\n")
            L.append("\n| block | calls | mean µs | p99 µs | max µs | ns / sample |\n|---|---|---|---|---|---|\n")
            for role in ["fsrc"] + PRE[1:] + POST + ["stamp", "latsink"]:
                if role in r["per_block"]:
                    v = r["per_block"][role]
                    L.append(f"| {role} | {v['calls']} | {v['mean_us']:.2f} | {v['p99_us']:.1f} | {v['max_us']:.0f} | {v['ns_per_sample']:.1f} |\n" if v["ns_per_sample"] is not None else f"| {role} | {v['calls']} | {v['mean_us']:.2f} | {v['p99_us']:.1f} | {v['max_us']:.0f} | - |\n")
    if "M2" in res:
        L.append("\n## M2 — scheduler cost per invocation on a synthetic copy graph (one worker, best of 3)\n\n| N | chains | variant | RR ns/inv | EDF ns/inv | RM ns/inv |\n|---|---|---|---|---|---|\n")
        rows = {}
        for j in res["M2"]:
            rows.setdefault((j["batch"], j["chains"], j["variant"]), {})[j["policy"]] = j["ns_per_invocation"]
        for k in sorted(rows):
            v = rows[k]
            L.append(f"| {k[0]} | {k[1]} | {k[2]} | {v.get('rr', float('nan')):.0f} | {v.get('edf', float('nan')):.0f} | {v.get('rm', float('nan')):.0f} |\n")
    if "M3" in res:
        L.append("\n## M3 — non-preemptive blocking bound\n\n| N | longest call µs | block | class deadline 0.25 × period at 2.5 Msps µs | at 5 Msps µs |\n|---|---|---|---|---|\n")
        for N, r in sorted(res["M3"].items(), key=lambda kv: int(kv[0])):
            L.append(f"| {N} | {r['longest_call_us']:.0f} | {r['longest_call_block']} | {r['tight_deadline_2p5_us']:.0f} | {r['tight_deadline_5_us']:.0f} |\n")
    if "M4" in res:
        L.append("\n## M4 — EDF selection oracle (2 workers, 3 receivers, 2.5 Msps, N = 1024, 30 s)\n\n| setting | job starts | inversions | ratio | pipeline ratio | waiting job of a tighter class | chain 0 batch RT mean µs | chains 1,2 |\n|---|---|---|---|---|---|---|---|\n")
        for name, r in res["M4"].items():
            o = r["oracle"]; pcs = r["per_chain_batch_rt"]
            c0 = f"{pcs[0]['mean_us']:.0f}" if pcs and pcs[0] and pcs[0].get("n") else "-"
            c12 = ", ".join(f"{p['mean_us']:.0f}" for p in pcs[1:] if p and p.get("n"))
            L.append(f"| {name} | {o['starts']} | {o['inversions']} | {o['inversion_ratio']:.2e} | {o['pipeline_inversion_ratio']:.2e} | {o['inversions_waiting_job_tighter_class']} | {c0} | {c12} |\n")
    if "M5" in res:
        L.append("\n## M5 — trace overhead at an unsaturated point (1 receiver, 1 worker, 2.5 Msps, N = 1024, 30 s)\n\n| policy | frame RT mean µs untraced | traced | Δ | std untraced | traced | run time / air untraced | traced |\n|---|---|---|---|---|---|---|---|\n")
        for pol in ("rr", "edf", "rm"):
            u = res["M5"].get(f"{pol}_untraced"); t = res["M5"].get(f"{pol}_traced")
            if u and t:
                L.append(f"| {pol} | {u['frame_rt']['mean_us']:.0f} | {t['frame_rt']['mean_us']:.0f} | {t['frame_rt']['mean_us'] - u['frame_rt']['mean_us']:+.0f} | {u['frame_rt']['std_us']:.0f} | {t['frame_rt']['std_us']:.0f} | {u['realtime_ratio']:.3f} | {t['realtime_ratio']:.3f} |\n")
    if "M6" in res:
        L.append(f"\n## M6 — scheduler pass cost on four workers (light mix 1.25/1.25/2.5/5 Msps, N = {M6_BATCH}, rotation 1, 20 s, every category traced, selection pass bounded at {M6_PASS_US} µs)\n")
        L.append("\nBatch response time per receiver (mean µs, and the fraction of batches later than the receiver's own period):\n\n| policy | ratio | rx 0 | rx 1 | rx 2 | rx 3 (5 Msps) | EDF pipeline misses |\n|---|---|---|---|---|---|---|\n")
        for key, r in res["M6"].items():
            cells = []
            for pc in r["per_chain"]:
                br = pc.get("batch_rt") or {}
                cells.append(f"{br.get('mean_us', float('nan')):.0f} ({100 * br.get('over_period', 0) / max(br.get('n', 1), 1):.1f}%)" if br else "-")
            e = [pc["edf"] for pc in r["per_chain"] if pc.get("edf")]
            L.append(f"| {r['policy']} | {r['sched_ratio']} | " + " | ".join(cells) + f" | {sum(x['misses'] for x in e) if e else '-'} |\n")
        L.append("\nScheduler events per worker inside the window (rate, mean and p99 duration, share of the worker's time):\n\n| policy | ratio | event | per s | mean µs | p99 µs | busy % |\n|---|---|---|---|---|---|---|\n")
        for key, r in res["M6"].items():
            for k in ("sweep", "messagePhase", "stateSync", "schedulerMessages", "removalCleanup", "blockMessages", "releaseScan", "workProbe"):
                v = r["kinds"].get(k)
                if v:
                    L.append(f"| {r['policy']} | {r['sched_ratio']} | {k} | {v['per_s_per_worker']:.0f} | {v['mean_us']:.1f} | {v['p99_us']:.1f} | {100 * v['busy_share']:.1f} |\n")
        L.append("\nJobs discarded by the re-sync (EDF only tracks jobs; mean per re-sync, max, share of re-syncs that discarded any): " + "; ".join(f"{r['policy']} r{r['sched_ratio']}: {r['jobs_discarded_per_sync']['mean']:.2f}, {r['jobs_discarded_per_sync']['max']}, {100 * r['jobs_discarded_per_sync']['syncs_with_discards']:.0f}%" for r in res["M6"].values() if r.get("jobs_discarded_per_sync")) + "\n")
        L.append("\nMean gap between consecutive passes of a worker (µs, one value per worker): " + "; ".join(f"{r['policy']} r{r['sched_ratio']}: " + ", ".join(f"{g:.1f}" for g in r["gap_between_sweeps_us"]) for r in res["M6"].values()) + "\n")
        L.append("\nPasses ended by a bound (per s per worker, time budget / selection count; round robin has no bound): " + "; ".join(f"{r['policy']} r{r['sched_ratio']}: {r['bound_hits']['time_per_s_per_worker']:.1f} / {r['bound_hits']['count_per_s_per_worker']:.1f}" for r in res["M6"].values() if r.get("bound_hits")) + "\n")
        L.append(M6_RATIO_NOTE)
        L.append("\n| policy | ratio | passes per s | mean pass µs | message phases per s | interval between message phases ms | stateSync busy % |\n|---|---|---|---|---|---|---|\n")
        for key, r in res["M6"].items():
            sw = r["kinds"].get("sweep"); mp = r["kinds"].get("messagePhase"); ss = r["kinds"].get("stateSync")
            if sw and mp and ss and mp["per_s_per_worker"] > 0:
                L.append(f"| {r['policy']} | {r['sched_ratio']} | {sw['per_s_per_worker']:.0f} | {sw['mean_us']:.1f} | {mp['per_s_per_worker']:.0f} | {1e3 / mp['per_s_per_worker']:.2f} | {100 * ss['busy_share']:.1f} |\n")
    open(os.path.join(out, "MICRO.md"), "w").write("".join(L))


M6_RATIO_NOTE = """
### What the ratio is

`process_stream_to_message_ratio` is a setting of GR4's scheduler (`core/include/gnuradio-4.0/Scheduler.hpp`,
default 16). Every worker runs a loop of *passes*; in a pass it selects blocks and calls their `work()`. The
worker keeps a pass counter, and once every `ratio` passes it opens a *message phase* before doing any work.
The message phase is where everything that is not stream processing happens, in this order: the scheduler's and
graph's own messages (worker 0 only), cleanup of removed blocks, zombie reaping, adoption of new blocks, the
re-sync of every block's scheduling state (`stateSync`), the static re-ordering of the worker's block list,
each block's `processScheduledMessages()` (settings changes and other block messages), and buffer house-keeping
unless the house-keeping policy is Light. Worker 0 also opens the phase early when a scheduler message is
pending, so the ratio does not bound the latency of scheduler and graph messages; it does bound everything
else on that list. The ratio is a count of passes, not a time: the interval between two message phases is
`ratio` × the worker's pass duration, and the pass duration depends on the policy and the load (the table
below gives both for this run). A power of two is slightly cheaper (the counter wraps with a mask instead of
a modulo).

The re-sync is what makes the ratio matter to EDF. `syncSchedStates()` assigns whole scheduling states, and
under a policy that tracks releases the worker then rebuilds its release storage — on every message phase.
Until 2026-09-22 (`9126f2a`, `7af5453`) that rebuild flattened the whole graph and recomputed its adjacency
each time, and discarded every outstanding job and last-release time, whether or not the graph had changed.
Now the flattened graph and adjacency are cached per worker and rebuilt only when the scheduler's topology
generation has moved (it is bumped whenever work quiescence is released, which every structural change
takes), and the admitted jobs, last-release times and overrun counts are carried across a re-sync whose
block list is pointer-identical and whose generation is unchanged. The re-sync still runs on every message
phase; it is cheaper when nothing changed. Under RR and RM the re-sync is a few microseconds; under EDF it
is the storage rebuild. At the default ratio of 16 that recurs every 16 passes, which is the `stateSync` row
above (since `9126f2a` the marker covers the state rebuild alone; before, it ran to the end of the phase
and read as nearly all of it). At 4096 the same work recurs 256× less often and its busy share falls below
one percent, which is why the sweeps compare policies at 4096.

### Choosing and setting a value

The ratio trades scheduler overhead against reaction time. A larger ratio makes every message phase rarer:
less re-sync cost, more passes per second, but a longer wait before a settings change is applied, a new block
is adopted or a removed one is released. A smaller ratio does the reverse. The rule is: take the largest
ratio whose message-phase interval is still inside the latency the application can tolerate for a settings
change or a graph mutation, and check that `stateSync`'s busy share is negligible at that ratio. For a
static graph with no settings traffic while running, which is what the sweeps use, 4096 is that value on this
machine (an interval in the tens of milliseconds, re-sync below 1 %). A graph that expects settings messages
at a given rate needs an interval shorter than their spacing; divide that by the measured pass duration to
get the ratio, and round to a power of two. Do not pick the ratio to make one policy look better: it changes
the re-sync cost of EDF and the pass rate of every policy at once, so policies are compared at the same
ratio.

Setting it: `rx_latency4 --sched-ratio N` stages it as the scheduler setting `process_stream_to_message_ratio`
in the property map applied before the scheduler starts (staging then applying; `set()` alone changes
nothing); the sweep driver takes `sched_ratio` from the machine profile (`experiments/profiles/*.json`,
`x86-8core-r4096.json` is the 4096 variant) and passes it the same way; in GR4 code it is the constructor
setting `{"process_stream_to_message_ratio", gr::Size_t(N)}` of any `gr::scheduler::Simple`. The value each
run used is recorded as `sched_ratio` in its `latency_summary.json` and `trace_meta.json`.
"""


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out-dir", required=True)
    ap.add_argument("--cell", default=os.path.join(HERE, "data", "rt_300_300_102934_QPSK_1_2_s1"))
    ap.add_argument("--only", default="M1,M2,M3,M4,M5,M6")
    ap.add_argument("--cpus", help="pin each run's workers to the first --threads CPUs of this list, e.g. 4-7 (rx_latency4 --cpus)")
    a = ap.parse_args()
    if a.cpus:
        for tok in a.cpus.split(","):
            lo, _, hi = tok.partition("-")
            CPUS.extend(range(int(lo), int(hi or lo) + 1))
    os.chdir(HERE)
    os.makedirs(a.out_dir, exist_ok=True)
    log = os.path.join(a.out_dir, "micro.log")
    want = set(a.only.split(","))
    path = os.path.join(a.out_dir, "micro.json")
    res = json.load(open(path)) if os.path.exists(path) else {}
    if "M1" in want:
        res["M1"] = m1(a.cell, a.out_dir, log)
    if "M2" in want:
        res["M2"] = m2(a.out_dir, log)
    if "M3" in want and "M1" in res:
        res["M3"] = {N: {"longest_call_us": r["longest_call_us"], "longest_call_block": r["longest_call_block"], "tight_deadline_2p5_us": 0.25 * int(N) / 2.5e6 * 1e6, "tight_deadline_5_us": 0.25 * int(N) / 5e6 * 1e6} for N, r in res["M1"].items()}
    if "M4" in want:
        res["M4"] = m4(a.cell, a.out_dir, log)
    if "M5" in want:
        res["M5"] = m5(a.cell, a.out_dir, log)
    if "M6" in want:
        res["M6"] = m6(a.cell, a.out_dir, log)
    json.dump(res, open(path, "w"), indent=1)
    write_md(res, a.out_dir)
    print("wrote", path, "and MICRO.md")


if __name__ == "__main__":
    main()
